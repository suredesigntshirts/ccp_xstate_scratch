                "params": {
                  "failure": {
                    "value": null
                  },
                  "failure.kind": {
                    "value": "rejected"
                  },
                  "failure.sha": "context.pr.headSha",
                  "failure.url": "context.pr.url",
                  "failure.detail": {
                    "value": null
                  }
                }
              }
            ]
          }
        ],
        "onError": {
          "target": "replanning",
          "actions": [
            {
              "type": "set",
              "params": {
                "failure": {
                  "value": null
                },
                "failure.kind": {
                  "value": "error"
                },
                "failure.sha": {
                  "value": null
                },
                "failure.url": {
                  "value": null
                },
                "failure.detail": "event.error"
              }
            }
          ]
        }
      },
      "on": {
        "tripwire": {
          "target": "replanning",
          "guard": "tripwireOnPr",
          "actions": [
            {
              "type": "set",
              "params": {
                "failure": {
                  "value": null
                },
                "failure.kind": {
                  "value": "tripwire"
                },
                "failure.sha": {
                  "value": null
                },
                "failure.url": "event.url",
                "failure.detail": {
                  "value": null
                }
              }
            }
          ]
        },
        "ci.observed": [
          {
            "target": "building",
            "guard": "redOnHead",
            "actions": [
              {
                "type": "set",
                "params": {
                  "ci": "event.observed"
                }
              },
              {
                "type": "set",
                "params": {
                  "failure": {
                    "value": null
                  },
                  "failure.kind": {
                    "value": "check"
                  },
                  "failure.sha": "event.observed.sha",
                  "failure.url": "event.observed.url",
                  "failure.detail": "event.observed.failing"
                }
              }
            ]
          },
          {
            "target": "replanning",
            "guard": "redOnHead",
            "actions": [
              {
                "type": "set",
                "params": {
                  "ci": "event.observed"
                }
              },
              {
                "type": "set",
                "params": {
                  "failure": {
                    "value": null
                  },
                  "failure.kind": {
                    "value": "check"
                  },
                  "failure.sha": "event.observed.sha",
                  "failure.url": "event.observed.url",
                  "failure.detail": "event.observed.failing"
                }
              }
            ]
          },
          {
            "target": "merging",
            "guard": "byPolicy",
            "actions": [
              {
                "type": "set",
                "params": {
                  "ci": "event.observed"
                }
              },
              {
                "type": "set",
                "params": {
                  "approval.choice": {
                    "value": "approve"
                  },
                  "approval.by": {
                    "value": "policy"
                  },
                  "approval.sha": "context.pr.headSha",
                  "approval.touchesCi": "event.observed.touchesCi"
                }
              }
            ]
          },
          {
            "target": "merging",
            "actions": [
              {
                "type": "set",
                "params": {
                  "ci": "event.observed"
                }
              }
            ]
          },
          {
            "target": "asking",
            "actions": [
              {
                "type": "set",
                "params": {
                  "ci": "event.observed"
                }
              }
            ]
          },
          {
            "target": "askingCi",
            "actions": [
              {
                "type": "set",
                "params": {
                  "ci": "event.observed"
                }
              }
            ]
          },
          {
            "target": "waitingCi",
            "actions": [
              {
                "type": "set",
                "params": {
                  "ci": "event.observed"
                }
              }
            ]
          },
          {
            "guard": "onHead",
            "actions": [
              {
                "type": "set",
                "params": {
                  "ci": "event.observed"
                }
              }
            ]
          }
        ],
        "pr.head.observed": [
          {
            "target": "landedUnverified",
            "guard": "mergedOutside"
          },
          {
            "target": "judging",
            "reenter": true,
            "actions": [
              {
                "type": "set",
                "params": {
                  "pr.headSha": "event.observed.head",
                  "ci": {
                    "value": null
                  }
                }
              }
            ]
          }
        ]
      }
    },
    "merging": {
      "meta": {
        "needs": [
          "verifiedHead",
          "ciPassed",
          "approved"
        ]
      },
      "invoke": {
        "id": "merge",
        "src": "merge",
        "input": {
          "pr": "context.pr",
          "sha": "context.verdict.sha"
        },
        "onDone": {
          "target": "done",
          "actions": [
            {
              "type": "set",
              "params": {
                "merge.sha": "event.output.sha"
              }
            }
          ]
        },
        "onError": {
          "target": "replanning",
          "actions": [
            {
              "type": "set",
              "params": {
                "failure": {
                  "value": null
                },
                "failure.kind": {
                  "value": "merge"
                },
                "failure.sha": "context.verdict.sha",
                "failure.url": "context.pr.url",
                "failure.detail": "event.error"
              }
            }
          ]
        }
      }
    },
    "replanning": {
      "invoke": {
        "id": "ask",
        "src": "ask",
        "input": {
          "question": {
            "value": "This item stalled. Replan it with a written five whys, or drop it?"
          },
          "choices": {
            "value": [
              "replan",
              "drop"
            ]
          },
          "verdict": "context.verdict",
          "failure": "context.failure"
        },
        "onDone": [
          {
            "target": "briefing",
            "guard": "replan",
            "actions": [
              {
                "type": "set",
                "params": {
                  "why": "event.output.why",
                  "builds": {
                    "value": 0
                  },
                  "pr": {
                    "value": null
                  },
                  "verdict": {
                    "value": null
                  },
                  "approval": {
                    "value": null
                  },
                  "ci": {
                    "value": null
                  }
                }
              },
              {
                "type": "inc",
                "params": "attempt"
              }
            ]
          },
          {
            "target": "dropped",
            "guard": "drop"
          },
          {
            "target": "replanning",
            "reenter": true,
            "description": "replan without a written why: ask again"
          }
        ],
        "onError": "dropped"
      }
    },
    "done": {
      "type": "final",
      "meta": {
        "needs": [
          "isMerged"
        ]
      }
    },
    "landedUnverified": {
      "type": "final"
    },
    "dropped": {
      "type": "final"
    }
  },
  "meta": {
    "guards": {
      "hasIssue": [
        "context.issue.url",
        "context.issue.expect"
      ],
      "hasBriefs": [
        "context.briefs.builder",
        "context.briefs.verifier"
      ],
      "buildsLeft": [
        {
          "path": "context.builds",
          "below": 2
        }
      ],
      "hasPr": [
        "context.pr.branch",
        "context.pr.headSha"
      ],
      "failed": [
        {
          "path": "context.verdict.result",
          "is": "FAIL"
        }
      ],
      "verifiedHead": [
        {
          "path": "context.verdict.result",
          "is": "PASS"
        },
        {
          "path": "context.verdict.sha",
          "same": "context.pr.headSha"
        },
        {
          "path": "context.verdict.briefHash",
          "same": "context.briefs.verifier"
        }
      ],
      "ciPassed": [
        {
          "path": "context.ci.sha",
          "same": "context.pr.headSha"
        },
        {
          "path": "context.ci.conclusion",
          "is": "success"
        }
      ],
      "ciGreen": [
        {
          "path": "context.ci.sha",
          "same": "context.pr.headSha"
        },
        {
          "path": "context.ci.conclusion",
          "is": "success"
        },
        {
          "path": "context.ci.touchesCi",
          "is": false
        }
      ],
      "ciGreenEdited": [
        {
          "path": "context.ci.sha",
          "same": "context.pr.headSha"
        },
        {
          "path": "context.ci.conclusion",
          "is": "success"
        },
        {
          "path": "context.ci.touchesCi",
          "is": true
        }
      ],
      "approved": [
        {
          "path": "context.approval.choice",
          "is": "approve"
        },
        {
          "path": "context.approval.sha",
          "same": "context.pr.headSha"
        },
        {
          "path": "context.approval.touchesCi",
          "same": "context.ci.touchesCi"
        }
      ],
      "byPolicy": [
        {
          "path": "context.approver",
          "is": "policy"
        },
        {
          "path": "context.ci.touchesCi",
          "is": false
        }
      ],
      "approve": [
        {
          "path": "event.output.choice",
          "is": "approve"
        }
      ],
      "replan": [
        {
          "path": "event.output.choice",
          "is": "replan"
        },
        "event.output.why"
      ],
      "drop": [
        {
          "path": "event.output.choice",
          "is": "drop"
        }
      ],
      "isMerged": [
        "context.merge.sha"
      ],
      "tripwireOnPr": [
        {
          "path": "event.url",
          "same": "context.pr.url"
        }
      ],
      "redOnHead": [
        {
          "path": "event.observed.conclusion",
          "is": "failure"
        },
        {
          "path": "event.observed.sha",
          "same": "context.pr.headSha"
        }
      ],
      "onHead": [
        {
          "path": "event.observed.sha",
          "same": "context.pr.headSha"
        }
      ],
      "mergedOutside": [
        {
          "path": "event.observed.merged",
          "is": true
        }
      ]
    },
    "delays": {
      "buildTimeout": 3600000
    },
    "ci": {
      "required": [
        "test"
      ],
      "paths": [
        ".github/"
      ]
    },
    "input": {
      "type": "object",
      "required": [
        "issue"
      ],
      "properties": {
        "issue": {
          "type": "object",
          "required": [
            "url",
            "expect"
          ],
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1
            },
            "expect": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "approver": {
          "enum": [
            "policy"
          ]
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "events": {
      "tripwire": {
        "type": "object",
        "required": [
          "url",
          "rounds",
          "limit"
        ],
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1
          },
          "rounds": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          }
        }
      },
      "pr.head.observed": {
        "type": "object",
        "required": [
          "observed"
        ],
        "properties": {
          "observed": {
            "type": "object",
            "required": [
              "head",
              "merged"
            ],
            "properties": {
              "head": {
                "$ref": "#sha"
              },
              "merged": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "ci.observed": {
        "type": "object",
        "required": [
          "observed"
        ],
        "properties": {
          "observed": {
            "type": "object",
            "required": [
              "sha",
              "conclusion",
              "touchesCi"
            ],
            "properties": {
              "sha": {
                "$ref": "#sha"
              },
              "conclusion": {
                "enum": [
                  "success",
                  "failure",
                  "pending"
                ]
              },
              "touchesCi": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "actors": {
      "brief": {
        "type": "object",
        "required": [
          "builder",
          "verifier"
        ],
        "properties": {
          "builder": {
            "type": "string",
            "minLength": 1
          },
          "verifier": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "build": {
        "type": "object",
        "required": [
          "pr"
        ],
        "properties": {
          "pr": {
            "type": "object",
            "required": [
              "branch",
              "headSha",
              "url"
            ],
            "properties": {
              "branch": {
                "type": "string",
                "minLength": 1
              },
              "headSha": {
                "$ref": "#sha"
              },
              "url": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "verify": {
        "type": "object",
        "required": [
          "result",
          "report"
        ],
        "properties": {
          "result": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "report": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "ask": {
        "type": "object",
        "required": [
          "choice",
          "by"
        ],
        "properties": {
          "choice": {
            "type": "string"
          },
          "by": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string"
          }
        }
      },
      "merge": {
        "type": "object",
        "required": [
          "sha"
        ],
        "properties": {
          "sha": {
            "$ref": "#sha"
          }
        }
      }
    },
    "schemas": {
      "sha": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}$"
      }
    }
  }
}
